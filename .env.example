DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=keyneswatch
DB_PASSWORD=change-me
DB_NAME=keyneswatch

# Required for FRED-backed series.
FRED_API_KEY=replace-with-your-fred-api-key

# Required for BEA-backed NIPA/Kalecki series.
